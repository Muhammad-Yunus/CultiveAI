{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production node dist/server.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/server.mjs",
    "preview": "vite preview",
    "db:push": "drizzle-kit push",
    "simulate": "tsx scripts/simulate-ingest.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "postgres": "^4.1.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
